    "firecrawl": {
      "command": [
        "npx",
        "-y",
        "firecrawl-mcp"
      ],
      "enabled": true,
      "environment": {
        "FIRECRAWL_API_KEY": "op://Personal/Firecrawl/API Key"
      },
      "type": "local"
    },
    "peep": {
      "command": [
        "/Users/drew/.local/bin/peep",
        "mcp"
      ],
      "enabled": true,
      "environment": {
        "BROWSER_HEADLESS": "false",
        "BROWSER_ENGINE": "firefox"
      },
      "type": "local"
    },

