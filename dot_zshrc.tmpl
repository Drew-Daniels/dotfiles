{{- template "base.sh.tmpl" }}

# homebrew
PATH="/usr/local/sbin:$PATH"

eval "$(/opt/homebrew/bin/brew shellenv)"

# homebrew shell completion
if type brew &>/dev/null; then
  FPATH="$(brew --prefix)/share/zsh/site-functions:${FPATH}"
fi

# brew curl shell completion
fpath=("$(brew --prefix)/opt/curl/share/zsh/site-functions" $fpath)

# clang
export PATH="/opt/homebrew/opt/llvm/bin:$PATH"

# mise
eval "$(/opt/homebrew/opt/mise/bin/mise activate zsh)"

# zoxide
eval "$(zoxide init --cmd j zsh)"

# starship
eval "$(starship init zsh)"

# neovim
alias upgrade_nvim="brew upgrade nvim --fetch-HEAD"

# Add mirth-cli completions to fpath (if installed)
[[ -d $HOME/Library/Caches/mirth-cli/autocomplete/functions/zsh ]] && \
  fpath=($HOME/Library/Caches/mirth-cli/autocomplete/functions/zsh $fpath)
# Initialize completions (once, after all fpath modifications)
autoload -Uz compinit bashcompinit
compinit
bashcompinit

# TODO: See about moving this either into base.sh.tmpl or another template file - since this needs to be called after compinit
# aws cli
complete -C '/opt/homebrew/bin/aws_completer' aws

# opentofu
complete -o nospace -C /opt/homebrew/bin/tofu tofu

# 1password
eval "$(op completion zsh)"
compdef _op op

# direnv
eval "$(direnv hook zsh)"

# vscode-xml lemminx
export PATH="$PATH:$HOME/.config/vscode-xml"

# bat
alias bat="bat --theme 'auto:system' --theme-dark 'gruvbox-dark' --theme-light 'Catppuccin Latte'"

# Android Studio
export ANDROID_HOME=$HOME/Library/Android/sdk
export PATH=$PATH:$ANDROID_HOME/platform-tools

# Claude
# export CLAUDE_CODE_USE_BEDROCK=1

# #69824
# #68619
# #32795
# Workaround for a bug in Opus 4.6 where the model doesn't wait for subagents to finish and duplicates research.
export CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1

# Increase shell file descriptor limit - default is 256 (low)
ulimit -n 10240

# Melos
export PATH="$PATH":"$HOME/.pub-cache/bin"

# Bun
export PATH="$HOME/.bun/bin:$PATH"

# pipx
export PATH="$HOME/.local/bin:$PATH"

# nux
export XDG_CONFIG_HOME="$HOME/.config"

{{ if eq .homeOrWork "work" -}}
# WORK
# rancher desktop
export PATH="$PATH:$HOME/.rd/bin"

# jira-cli
# TODO: Enable once I figure out a difference mechanism for making these available to environment across entire system, rather than re-export these every time a new shell is created
# if command -v op >/dev/null 2>&1; then
#   string=$(op item get nzd745uynzi2xs3reubrgfsfmq --reveal --fields label=hostname,email,api_token)
#
#   secrets=(${(s:,:)string})
#
#   export JIRA_HOSTNAME="${secrets[1]}"
#   export JIRA_API_EMAIL="${secrets[2]}"
#   export JIRA_API_TOKEN="${secrets[3]}"
# fi

# mysql
export PATH=$PATH:/Applications/MySQLWorkbench.app/Contents/MacOS

# podman
export PODMAN_COMPOSE_WARNING_LOGS=false
{{- end -}}

{{ if eq .homeOrWork "home" -}}

alias docker=podman

# Opus 4.7 is objectively worse
alias claude=claude --model "Opus 4.6 Max"

# autin
# eval "$(atuin init zsh)"

# mysql-client (for mysqldump)
export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"

{{- end -}}
