{{ if or (eq .chezmoi.os "darwin") (eq .osid "linux-debian") (eq .osid "linux-fedora") -}}
#!/bin/sh

target="$HOME/.config/kotlin-lsp"

if [ ! -f "$target/bin/intellij-server" ]; then
  tmpdir=$(mktemp -d)
  cd "$tmpdir" || exit

  version=$(curl -sL https://api.github.com/repos/Kotlin/kotlin-lsp/releases/latest | jq -r '.tag_name' | sed 's|kotlin-lsp/v||')

{{ if eq .chezmoi.os "darwin" -}}
{{ if eq .chezmoi.arch "arm64" -}}
  pkg="kotlin-server-${version}-aarch64.sit"
{{ else -}}
  pkg="kotlin-server-${version}.sit"
{{ end -}}
{{ else -}}
{{ if eq .chezmoi.arch "arm64" -}}
  pkg="kotlin-server-${version}-aarch64.tar.gz"
{{ else -}}
  pkg="kotlin-server-${version}.tar.gz"
{{ end -}}
{{ end -}}

  curl -LO "https://download.jetbrains.com/language-server/kotlin-server/${version}/${pkg}"

{{ if eq .chezmoi.os "darwin" -}}
  mkdir -p extracted
  cd extracted || exit
  tar xf "../${pkg}"
{{ else -}}
  mkdir -p extracted
  tar xzf "${pkg}" -C extracted
{{ end -}}

  mkdir -p "$target"
  cp -R extracted/kotlin-server*/* "$target/" 2>/dev/null || cp -R extracted/* "$target/"
  chmod +x "$target/bin/intellij-server"

  cd "$HOME" || exit
  rm -rf "$tmpdir"
fi
{{ end -}}
